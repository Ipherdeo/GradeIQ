# Add these values in Vercel Project Settings → Environment Variables. Never commit .env.
# Choose ONE provider configuration below.

# VyceAI (OpenAI-compatible). Its API does not provide Anthropic's server-side
# web-search tool, so research answers rely on the model's own knowledge.
AI_API_FORMAT=openai
AI_API_BASE_URL=https://vyceai.com/v1
AI_API_KEY=your-vyceai-key
AI_MODEL=claude-sonnet-4-6

# Direct Anthropic (enables adaptive thinking and the server-side web-search tool)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# Server-side rate limit: requests per IP per window. Use Upstash in production
# so rate limits persist across serverless instances.
AI_RATE_MAX_REQUESTS=6
AI_RATE_WINDOW_SECONDS=60
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token
